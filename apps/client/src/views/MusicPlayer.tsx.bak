import React from 'react';
import { useLiquidState } from '../components/LiquidStateContext';
import { ParameterPanel } from '../components/ParameterPanel';
import { OpticsFilter } from '../components/OpticsFilter';

export const MusicPlayer: React.FC = () => {
  // removed glassBackgroundOpacity
  // Using some vibrant abstract images for albums to show off refraction
  const albums = [
    '1550684848-fac1c5b4e853', '1574169208507-84376144848b', '1493246507139-91e8fad9978e', '1518640467708-6833f48622c8',
    '1523821741446-ed286bba8d23', '1528459801416-a1e533866bc0', '1505909182942-e2f09aee3e89', '1500462918059-b1a0cb512f1d',
    '1493246507139-91e8fad9978e', '1550684848-fac1c5b4e853', '1574169208507-84376144848b', '1518640467708-6833f48622c8'
  ].map(id => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=400&q=80`);
  
  return (
    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', width: '100%', maxWidth: '800px', margin: '0 auto' }}>
      <div style={{ alignSelf: 'flex-start', marginBottom: '2rem' }}>
        <h1 style={{ fontSize: '2.5rem', fontWeight: 700, margin: '0 0 1rem 0', color: '#111' }}>Music Player</h1>
        <p style={{ color: '#555', maxWidth: '700px', fontSize: '1rem', lineHeight: 1.6 }}>
          This fake music player UI tries to mimic the look of Apple Music's Liquid Glass panels, using a convex bezel and a subtle specular highlight.
        </p>
      </div>

      <div style={{ position: 'relative', width: '100%', height: '600px', background: '#fff', borderRadius: '16px', overflow: 'hidden', boxShadow: '0 24px 48px rgba(0,0,0,0.08)' }}>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '16px', padding: '16px', height: '100%', overflowY: 'auto' }}>
          {albums.map((src, i) => (
            <div key={i} style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              <img src={src} style={{ width: '100%', aspectRatio: '1', borderRadius: '8px', objectFit: 'cover' }} alt="Album Art" />
              <div style={{ fontSize: '0.65rem', color: '#555', fontWeight: 700, letterSpacing: '0.5px' }}>ALBUM TITLE {i+1}</div>
            </div>
          ))}
        </div>
        
        {/* The Liquid Glass Playback Bar */}
        <OpticsFilter id="music-filter" width={736} height={80} radius={40} />
        <div style={{
          position: 'absolute', bottom: '24px', left: '32px', right: '32px', height: '80px',
          borderRadius: '40px',
          backdropFilter: 'url(#music-filter)',
          WebkitBackdropFilter: 'url(#music-filter)',
          backgroundColor: 'rgba(255, 255, 255, 0.5)',
          boxShadow: '0 12px 32px rgba(0,0,0,0.15), inset 0 2px 4px rgba(255,255,255,0.4)',
          border: '1px solid rgba(255,255,255,0.3)',
          display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '2.5rem'
        }}>
          <div style={{ width: '24px', height: '24px', background: '#333', borderRadius: '4px' }} />
          <div style={{ width: '40px', height: '40px', background: '#111', borderRadius: '50%' }} />
          <div style={{ width: '24px', height: '24px', background: '#333', borderRadius: '4px' }} />
        </div>
      </div>

      <ParameterPanel />
    </div>
  );
};
